{
	"name": "platzi-intro-react-base",
	"version": "0.1.0",
	"dependencies": {
		"debug": "^4.4.3",
		"react": "^18",
		"react-dom": "^18",
		"react-icons": "^5.7.0",
		"react-scripts": "5.0.1",
		"web-vitals": "^2.1.4"
	},
	"scripts": {
		"start": "react-scripts start",
		"build": "react-scripts build",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d build",
		"eject": "react-scripts eject"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"plugin:react/recommended",
			"plugin:import/recommended"
		],
		"settings": {
			"import/resolver": {
				"node": {
					"extensions": [
						".js",
						".jsx"
					]
				}
			}
		}
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"eslint": "^8.57.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"gh-pages": "^6.3.0"
	},
	"homepage": "https://Hjuanma.github.io/curso-react-intro/"
}
