{
  "name": "platzi-intro-react-base",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "debug": "^4.4.3",
    "react": "^19.3",
    "react-dom": "^19.3",
    "react-icons": "^5.7.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:react/recommended",
      "plugin:import/recommended"
    ],
    "settings": {
      "import/resolver": {
        "node": {
          "extensions": [
            ".js",
            ".jsx"
          ]
        }
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@svgr/rollup": "^8.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.22.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.4.11"
  },
  "homepage": "https://Hjuanma.github.io/curso-react-intro/"
}
